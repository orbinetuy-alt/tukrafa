# Canonical production URL used by metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.elrafatravel.com

# Google Analytics 4 Measurement ID (Admin > Data streams > Web).
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-Y5D4HVVT1N

# Database provisioned through Vercel Marketplace > Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Stripe. Preview uses sk_test_; Production must use sk_live_.
# The webhook signing secret is different for every Stripe endpoint/mode.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Google service account. Share the booking calendar with this email as editor.
GOOGLE_CALENDAR_ID=calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ManyChat WhatsApp. The flow must contain the approved WhatsApp template.
MANYCHAT_API_TOKEN=REPLACE_ME
MANYCHAT_BOOKING_FLOW_NS=content_REPLACE_ME
# Optional: only required for the internal notification sent to Rafa.
MANYCHAT_RAFA_FLOW_NS=content_REPLACE_ME
RAFA_WHATSAPP_NUMBER=351REPLACE_ME
RAFA_NOTIFICATION_EMAIL=reservas@elrafatravel.com

# Transactional email.
RESEND_API_KEY=re_REPLACE_ME
RAFA_EMAIL=elrafatravelcrm@gmail.com
FROM_EMAIL=reservas@elrafatravel.com
